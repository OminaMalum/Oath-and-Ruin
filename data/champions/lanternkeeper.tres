passive_name = "Keep the Flame"
passive_description = "Healing an allied champion in a fight stores an ember (once per cast, up to 3). The next Lantern Light shields every allied champion inside it for 25 per ember, 3 s."
passive_value = 25.0
passive_range = 0.0
primary_color = Color(0.78, 0.7, 0.52, 1)
accent_color = Color(1.0, 0.82, 0.4, 1)
item_build = Array[StringName]([&"oathbound_plate", &"ash_hourglass", &"wayfarer_greaves", &"ember_edge"])
