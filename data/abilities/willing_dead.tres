[resource]
script = ExtResource("1_ab")
id = &"willing_dead"
display_name = "Willing Dead"
description = "Call a willing dead up to 6 m away for 8 s. It walks with you and strikes the champion fighting you, or the nearest enemy. Up to two: a third replaces the oldest. It never hits structures. Counterplay: break it (240 health), or step away from it."
