[resource]
script = ExtResource("1_ab")
id = &"reed_step"
display_name = "Reed Step"
description = "A short step along the ground (5.5 m) the way you are moving: 25 damage to enemies you pass. It cannot cross walls. Counterplay: once she has stepped in, back off; it is her only dash."
delivery = 3
damage = 25.0
cast_time = 0.05
recovery = 0.15
cooldown = 9.0
move_mult_while_casting = 1.0
range = 5.5
dash_distance = 5.5
dash_duration = 0.18
