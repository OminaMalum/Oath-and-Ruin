[resource]
script = ExtResource("1_ab")
id = &"break_their_line"
display_name = "Break Their Line"
description = "Ultimate. Lower the spear for 0.35 s, then charge 10 m: 140 damage to everyone you run through. The first champion stops you and is driven back 4 m. Walls stop it too. Counterplay: the lowered spear is the warning; step out of its line."
