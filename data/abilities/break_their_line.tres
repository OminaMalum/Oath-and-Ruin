is_ultimate = true
damage = 140.0
cast_time = 0.35
recovery = 0.25
cooldown = 60.0
move_mult_while_casting = 0.0
range = 10.0
dash_distance = 10.0
dash_duration = 0.35
stop_on_champion = true
push_distance = 4.0
scaling = 1
